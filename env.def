Bootstrap: docker
From: continuumio/miniconda3
%post -c /bin/bash
    # Update and install system wide software here
    apt-get update

    # installing dependencies
    conda config --add channels bioconda
    conda config --add channels conda-forge
    conda config --set channel_priority strict

    # install conda stuff here
    conda create -y --name assemblers myloasm 
    conda create -y --name tools minimap2 samtools bedtools bbmap pigz
    conda create -y --name binners metabat2 semibin remag python=3.10 boost-cpp=1.85.0
    conda create -y --name drep drep "pandas<2.0"
    conda create -y -n gtdbtk -c conda-forge -c bioconda gtdbtk=2.7.2
    conda create -y --name busco busco
    conda create -y --name checkm2 checkm2
   
    #GVCLASS
    apt-get update && apt-get install -y git curl build-essential
    export HOME=/root
    curl -fsSL https://pixi.sh/install.sh | bash
    export PATH="/root/.pixi/bin:$PATH"
    mkdir -p /opt/gvclass
    cd /opt/gvclass
    git clone https://github.com/NeLLi-team/gvclass.git .
    pixi install
