params {
    // ---- sample inputs, change to actual paths ----
    input_fgz = "/home/user/data/input.fastq.gz"
    outdir    = "out/"
    nametag   = ""
    assembly = ""
    samplesheet = ""
        // samplesheet should be a .csv of sample values:
        // fastq,assembly
        // /sample01.fastq.gz,
        // /sample02.fastq.gz,/sample02_assembly.fa
    // 'hifi' (PacBio HiFi) or 'ont' (Oxford Nanopore R10) - controls the
    // myloasm assembly preset and the minimap2 mapping preset.
    read_type = 'hifi'

    // ---- shared, persistent reference database location ----
    // Deliberately separate from --outdir: these are one-time downloads
    // reused across every sample/run, not per-run outputs. Point this at
    // wherever you/your team keep shared reference data.
    // defaults to the /refdbs folder
    db_dir = "/refdbs"

    // ---- thread counts, hardcoded values that you can edit ----
    threads_myloasm = 10
    threads_map     = 32
    threads_checkm2 = 10
    threads_gvclass = 24

    // ---- binner on/off switches ----
    run_metabat2   = true
    run_semibin2   = true
    run_remag      = true
    semibin_models = 'soil,self,global'   // comma-separated subset of: soil, self, global

    // ---- QC / taxonomy settings ----
    run_gtdbtk = true
    run_gvclass = true
    run_cmsearch  = false   // "fast mode" alternative to GTDB-Tk/GVClass
    busco_lineage           = 'eukaryota_odb10'
    gtdbtk_data_url         = 'https://data.gtdb.ecogenomic.org/releases/latest/auxillary_files/gtdbtk_package/full_package/gtdbtk_data.tar.gz'
    gvclass_repo_url        = 'https://github.com/NeLLi-team/gvclass.git'
    gvclass_max_bin_size_mb = 50
    cm_model_url     = 'https://rfam.org/family/RF01960/cm'
    threads_cmsearch = 8

    publish_mode = 'copy'
}

// Nextflow builds/caches a conda env per process based on each process's
// own `conda` directive - no container, no apptainer.
conda {
    enabled  = true
    channels = ['conda-forge', 'bioconda']
    // useMamba = true   // uncomment if mamba is installed - much faster solves
}

process {
    withLabel: 'assembly' {
        cpus   = params.threads_myloasm
        memory = '64 GB'
        time   = '24h'
    }
    withLabel: 'mapping' {
        cpus   = params.threads_map
        memory = '32 GB'
    }
    withLabel: 'binning' {
        cpus   = 16
        memory = '32 GB'
    }
    withLabel: 'qc' {
        cpus   = params.threads_checkm2
        memory = '32 GB'
    }
    withLabel: 'taxonomy' {
        cpus   = 16
        memory = '64 GB'
    }
    withLabel: 'gvclass' {
        cpus   = params.threads_gvclass
        memory = '64 GB'
    }
    withLabel: 'small' {
        cpus   = 4
        memory = '8 GB'
    }
    withLabel: 'cmsearch' {
        cpus   = params.threads_cmsearch
        memory = '16 GB'
    }
}

executor {
    name = 'local'
}

dag {
    enabled = true
    file    = 'pipeline_dag.html'
}

report {
    enabled = true
    file    = 'execution_report.html'
}

timeline {
    enabled = true
    file    = 'execution_timeline.html'
}
