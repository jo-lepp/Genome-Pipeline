params {
    // ---- installation options ----
    // by default the pipeline does not install containers
    // the first time running, set to true
    install_software = false
    install_databases  = false
    install_all        = false

    // conda environment cache; default location for conda environments to be stored
    conda_cache_dir = "${projectDir}/conda_cache"   // override with a shared absolute path on HPC

    // software directory - a location for software that is not a conda enviroment (gvclass, and ssuextract)
    // both are installed with pixi which strongly dislikes its installation folder changed.
    // to solve this problem, we install both in a directory called software. 
    software_dir    = "${projectDir}/software"

    // ---- single-sample inputs ----
    input_fgz = "/home/user/data/input.fastq.gz"
    nametag   = ""
    assembly  = ""   // path to an existing assembly - skips MYLOASM (single-sample mode only)

    // ---- multi-sample mode ----
    samplesheet = ""   // CSV: fastq,assembly - takes priority over input_fgz/assembly/nametag

    // ---- sequencing technology ----
    read_type = 'hifi'   // 'hifi' or 'ont' - controls MYLOASM/MAPPING presets

    // ---- outputs ----
    outdir       = "/home/user/data/output"
    publish_mode = "copy"

    // ---- shared, persistent reference database/tool location ----
    // Relative to wherever `nextflow run` is launched from - matches the
    // refdbs/ folder committed (and .gitignore'd) in this repo. Pass an
    // absolute path instead if you ever launch from elsewhere.
    db_dir        = "${projectDir}/refdbs"

    // ---- thread counts, matching the original script's hardcoded values ----
    threads_myloasm = 10
    threads_map     = 32
    threads_checkm2 = 10
    threads_gvclass = 24
    threads_gtdbtk = 16 // pplacer gets half of allocated cpus
    threads_cmsearch = 16
    threads_busco = 16

    // ---- binner on/off switches + SemiBin2 model selection ----
    binner                     = 'metabat'   // 'metabat' (default), 'semibin', or 'remag'
    remag_reject_binner        = 'metabat'   // 'metabat' or 'semibin' - only used when binner == 'remag'
    semibin_models             = 'soil'      // used only when binner == 'semibin' (or as the reject binner), must be 'soil', 'self', or 'global'

    // ---- QC settings ----
    busco_lineage = 'eukaryota_odb10'
    drep_ignore_genome_quality = true //needed to ensure that euks aren't filtered out during dRep

    // ---- taxonomy toggles ----
    run_gtdbtk  = true
    run_gvclass = true

    // ---- fast mode (alternative to GVClass) ----
    run_ssu_screen   = true
    fast_mode_tool = 'ssu_extract'
    fast_mode = false   // turns on 'cmsearch' (legacy, eukaryote-only) and disables gvclass

    // legacy cmsearch mode's Rfam model
    rfam_eukarya_cm_url = 'https://rfam.org/family/RF01960/cm'

    // SSUextract (default fast-mode tool)
    ssuextract_repo_url             = 'https://github.com/NeLLi-team/ssuextract.git'
    ssuextract_db_profile           = 'curated'   // 'curated' (~345 MiB) or 'img' (~841 MiB)
    ssuextract_tree_classification  = false

    // ---- reference database download URLs ----
    checkm1_data_url = "https://data.ace.uq.edu.au/public/CheckM_databases/checkm_data_2015_01_16.tar.gz"
    gtdbtk_data_url  = "https://data.gtdb.ecogenomic.org/releases/latest/auxillary_files/gtdbtk_package/full_package/gtdbtk_data.tar.gz"
    gvclass_repo_url = "https://github.com/NeLLi-team/gvclass.git"

    // ---- GVClass bin-size handling ----
    // Bins over this size are subsampled (split via `gt splitfasta`) rather
    // than excluded - see modules/gvclass.nf's FNA_PREP.
    gvclass_max_bin_size_mb = 50

    run_dastool      = true
    threads_dastool  = 16
}

// Nextflow builds/caches a conda env per process based on each process's
// own `conda` directive - no container, no apptainer.
// by default cache directory is conda_cache, in project directory; 
// location can be adjusted above in the parameters.
conda {
    enabled  = true
    channels = ['conda-forge', 'bioconda']
    cacheDir = params.conda_cache_dir
    // useMamba = true   // uncomment if mamba is installed - much faster solves
}

process {
    // installation happens on a local settings
    // jobs are not submitted since worker nodes are 
    // often not connected to the internet
    withLabel: 'install' {
        executor = 'local'
    }
    // computational requiremnts of each subtask
    withLabel: 'assembly' {
        cpus   = params.threads_myloasm
        memory = '64 GB'
        time   = '24h'
    }
    withLabel: 'mapping' {
        cpus   = params.threads_map
        memory = '32 GB'
    }
    withLabel: 'depth' {
        cpus = 1
        memory = '32 GB'
    }
    withLabel: 'binning' {
        cpus   = 16
        memory = '32 GB'
    }
    withLabel: 'checkm2' {
    cpus   = params.threads_checkm2
    memory = '32 GB'
    }

    withLabel: 'busco' {
    cpus   = params.threads_busco
    memory = '32 GB'
    }
    withLabel: 'taxonomy' {
        cpus   = params.threads_gtdbtk
        memory = '64 GB'
    }
    withLabel: 'cmsearch' {
        cpus   = params.threads_cmsearch
        memory = '16 GB'
    }
    withLabel: 'gvclass' {
        cpus   = params.threads_gvclass
        memory = '64 GB'
        // Works around a common conda/pixi-environment gap: if the
        // environment's dependency lock doesn't pull in ca-certificates,
        // Python has no valid default cert path and any HTTPS call inside
        // it (e.g. GVClass's setup-db) fails with CERTIFICATE_VERIFY_FAILED.
        // No-op if python3/certifi aren't available or aren't needed.
        beforeScript = '''
            if command -v python3 >/dev/null 2>&1 && python3 -c "import certifi" >/dev/null 2>&1; then
                export SSL_CERT_FILE="$(python3 -m certifi)"
                export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"
            fi
        '''
    }
    withLabel: 'ssuextract' {
        cpus   = 16
        memory = '128 GB'
        beforeScript = '''
            if command -v python3 >/dev/null 2>&1 && python3 -c "import certifi" >/dev/null 2>&1; then
                export SSL_CERT_FILE="$(python3 -m certifi)"
                export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"
            fi
        '''
    }
    withLabel: 'small' {
        cpus   = 4
        memory = '8 GB'
    }
}
// Default executor. This is what launches sub-tasks either as separate processes
// or as jobs on an hpc system. To modify executor Configuration
// change conf/hpc.config instead 
executor {
    name = 'local'
}

// Loads in the configuration for hpc systems
// eg slurm, sge, etc. You may need to edit
// or import an appropriate one for your use.
// see comments in conf/hpc.config for more details

includeConfig "${projectDir}/conf/hpc.config"

dag {
    enabled   = true
    file      = 'pipeline_dag.html'
    overwrite = true
}

report {
    enabled   = true
    file      = 'execution_report.html'
    overwrite = true
}

timeline {
    enabled   = true
    file      = 'execution_timeline.html'
    overwrite = true
}
