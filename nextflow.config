params {
    // ---- single-sample inputs ----
    input_fgz = "/home/user/data/input.fastq.gz"
    nametag   = ""
    assembly  = ""   // path to an existing assembly - skips MYLOASM (single-sample mode only)

    // ---- multi-sample mode ----
    samplesheet = ""   // CSV: fastq,assembly - takes priority over input_fgz/assembly/nametag

    // ---- sequencing technology ----
    read_type = 'hifi'   // 'hifi' or 'ont' - controls MYLOASM/MAPPING presets

    // ---- outputs ----
    outdir       = "/home/user/data/output"
    publish_mode = "copy"

    // ---- shared, persistent reference database/tool location ----
    // Relative to wherever `nextflow run` is launched from - matches the
    // refdbs/ folder committed (and .gitignore'd) in this repo. Pass an
    // absolute path instead if you ever launch from elsewhere.
    db_dir = "refdbs"

    // ---- thread counts, matching the original script's hardcoded values ----
    threads_myloasm = 10
    threads_map     = 32
    threads_checkm2 = 10
    threads_gvclass = 24
    threads_cmsearch = 8

    // ---- binner on/off switches + SemiBin2 model selection ----
    run_metabat2   = true
    run_semibin2   = true
    run_remag      = true
    semibin_models = 'soil,self,global'   // comma-separated subset of: soil, self, global

    // ---- QC settings ----
    busco_lineage = 'eukaryota_odb10'

    // ---- taxonomy toggles ----
    run_gtdbtk  = true
    run_gvclass = true

    // ---- fast mode (alternative to GTDB-Tk/GVClass) ----
    run_cmsearch   = false
    fast_mode_tool = 'ssu_extract'   // 'ssu_extract' (default) or 'cmsearch' (legacy, eukaryote-only)

    // legacy cmsearch mode's Rfam model
    rfam_eukarya_cm_url = 'https://rfam.org/family/RF01960/cm'

    // SSUextract (default fast-mode tool)
    ssuextract_repo_url             = 'https://github.com/NeLLi-team/ssuextract.git'
    ssuextract_db_profile           = 'curated'   // 'curated' (~345 MiB) or 'img' (~841 MiB)
    ssuextract_tree_classification  = false

    // ---- reference database download URLs ----
    checkm1_data_url = "https://data.ace.uq.edu.au/public/CheckM_databases/checkm_data_2015_01_16.tar.gz"
    gtdbtk_data_url  = "https://data.gtdb.ecogenomic.org/releases/latest/auxillary_files/gtdbtk_package/full_package/gtdbtk_data.tar.gz"
    gvclass_repo_url = "https://github.com/NeLLi-team/gvclass.git"

    // ---- GVClass bin-size handling ----
    // Bins over this size are subsampled (split via `gt splitfasta`) rather
    // than excluded - see modules/gvclass.nf's FNA_PREP.
    gvclass_max_bin_size_mb = 50
}

// Nextflow builds/caches a conda env per process based on each process's
// own `conda` directive - no container, no apptainer.
conda {
    enabled  = true
    channels = ['conda-forge', 'bioconda']
    // useMamba = true   // uncomment if mamba is installed - much faster solves
}

process {
    withLabel: 'assembly' {
        cpus   = params.threads_myloasm
        memory = '64 GB'
        time   = '24h'
    }
    withLabel: 'mapping' {
        cpus   = params.threads_map
        memory = '32 GB'
    }
    withLabel: 'binning' {
        cpus   = 16
        memory = '32 GB'
    }
    withLabel: 'qc' {
        cpus   = params.threads_checkm2
        memory = '32 GB'
    }
    withLabel: 'taxonomy' {
        cpus   = 16
        memory = '64 GB'
    }
    withLabel: 'gvclass' {
        cpus   = params.threads_gvclass
        memory = '64 GB'
    }
    withLabel: 'cmsearch' {
        cpus   = params.threads_cmsearch
        memory = '16 GB'
    }
    withLabel: 'ssuextract' {
        // matches SSUextract's own internal --max_cpus/--max_memory defaults -
        // it's a nested Nextflow pipeline managing its own tasks, so the
        // outer process needs headroom for whatever it spins up internally.
        cpus   = 16
        memory = '128 GB'
    }
    withLabel: 'small' {
        cpus   = 4
        memory = '8 GB'
    }
}

executor {
    // switch to 'slurm', 'sge', etc. for your HPC scheduler
    name = 'local'
}

dag {
    enabled = true
    file    = 'pipeline_dag.html'
}

report {
    enabled = true
    file    = 'execution_report.html'
}

timeline {
    enabled = true
    file    = 'execution_timeline.html'
}