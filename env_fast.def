Bootstrap: docker
From: continuumio/miniconda3
%post -c /bin/bash
    # Update and install system wide software here
    apt-get update

    # installing dependencies
    conda config --add channels bioconda
    conda config --add channels conda-forge
    conda config --set channel_priority strict

    # install conda stuff here
    conda create -y --name assemblers myloasm 
    conda create -y --name tools minimap2 samtools bedtools bbmap pigz
    conda install -y -n base -c conda-forge mamba
    mamba create -y --name drep python=3.9 drep "pandas<2.0"
    conda create -y --name busco busco
    conda create -y --name checkm2 checkm2
    conda create -y --name cmsearch infernal
