// ---- HPC scheduler profiles ----
// Select the appropriate scheduler with -profile <name>.
//
// These profiles select only the executor. CPU, memory, and runtime
// requirements are defined in nextflow.config.
//
// For examples of institution-specific configurations, see:
// https://nf-co.re/configs
//
// Either modify the configuration below, or copy and adapt 
// a suitable configuration, then provide it using -c. 
// (Nextflow.config settings will still be passed if a config file
// is provided in the command line call).
// Example:
//   nextflow run main.nf -profile slurm -c my_cluster.config

profiles {
    slurm {
        process.executor = 'slurm'
    }

    pbs {
        process.executor = 'pbspro'
    }

    sge {
        process.executor = 'sge'
    }

    lsf {
        process.executor = 'lsf'
    }
}
